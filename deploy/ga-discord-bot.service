[Unit]
Description=GA Discord bot
After=network.target mysql.service

[Service]
Type=simple
User=ga-discord-bot
WorkingDirectory=/opt/ga_discord2/bot
EnvironmentFile=/opt/ga_discord2/bot/.env
ExecStart=/opt/ga_discord2/bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
